{
  "compilerOptions": {
    "rootDir": "./",
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@mosaic/common": ["./packages/common/src/index.ts"],
      "@mosaic/common/*": ["./packages/common/src/*"],
      "@mosaic/mosaic": ["./packages/mosaic/index.tsx"],
      "@mosaic/mosaic/*": ["./packages/mosaic/*"],
      "@mosaic/element": ["./packages/element/src/index.ts"],
      "@mosaic/element/*": ["./packages/element/src/*"],
      "@mosaic/fractional-indexing": ["./packages/fractional-indexing/src/index.ts"],
      "@mosaic/fractional-indexing/*": ["./packages/fractional-indexing/src/*"],
      "@mosaic/laser-pointer": ["./packages/laser-pointer/src/index.ts"],
      "@mosaic/laser-pointer/*": ["./packages/laser-pointer/src/*"],
      "@mosaic/math": ["./packages/math/src/index.ts"],
      "@mosaic/math/*": ["./packages/math/src/*"],
      "@mosaic/utils": ["./packages/utils/src/index.ts"],
      "@mosaic/utils/*": ["./packages/utils/src/*"]
    }
  },
  "include": ["packages", "mosaic-app"],
  "exclude": ["examples", "dist", "types", "tests"]
}
