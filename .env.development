MODE="development"

# ---------------------------------------------------------------------------
# Backed services
# ---------------------------------------------------------------------------
#
# Blank by default, for the same reason as .env.production: the inherited
# values pointed at Excalidraw's own infrastructure, so even a development
# build was writing into their Firebase project and resolving share links
# through their API.
#
# Set the ones you need in .env.local (uncommitted) once you have your own
# services. See BRANDING.md for what each one backs.

# Shareable link backend (v2 JSON API)
VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=

# Public library browser + publish endpoint
VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=

# collaboration WebSocket server
VITE_APP_WS_SERVER_URL=http://localhost:3002

# Diagram-to-code AI backend
VITE_APP_AI_BACKEND=http://localhost:3016

# Firebase: share-link file storage and persisted scenes.
# Must be a single-quoted JSON object.
VITE_APP_FIREBASE_CONFIG=

# Premium tier, not resold here. See SHOW_UPSTREAM_PROMOS in app_constants.ts.
VITE_APP_PLUS_LP=
VITE_APP_PLUS_APP=http://localhost:3000
VITE_APP_PLUS_AUTO_REDIRECT=false

# put these in your .env.local, or make sure you don't commit!
# must be lowercase `true` when turned on
#
# whether to disable live reload / HMR. Usuaully what you want to do when
# debugging Service Workers.
VITE_APP_DEV_DISABLE_LIVE_RELOAD=
VITE_APP_ENABLE_TRACKING=false

# Error reporting is off unless you set a DSN for your own Sentry project.
VITE_APP_SENTRY_DSN=
VITE_APP_SENTRY_ENVIRONMENT=development

FAST_REFRESH=false

# The port the run the dev server
VITE_APP_PORT=3001

#Debug flags

# To enable bounding box for text containers
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=

# Set this flag to false if you want to open the overlay by default
VITE_APP_COLLAPSE_OVERLAY=true

# Set this flag to false to disable eslint
VITE_APP_ENABLE_ESLINT=true

# Enable PWA in dev server
VITE_APP_ENABLE_PWA=false

# Set this flag to true in .env.development.local to disable the prevent unload dialog
VITE_APP_DISABLE_PREVENT_UNLOAD=
