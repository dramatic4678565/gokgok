{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "paths": {
      "@mosaic/common": ["./common/src/index.ts"],
      "@mosaic/common/*": ["./common/src/*"],
      "@mosaic/element": ["./element/src/index.ts"],
      "@mosaic/element/*": ["./element/src/*"],
      "@mosaic/mosaic": ["./mosaic/index.tsx"],
      "@mosaic/mosaic/*": ["./mosaic/*"],
      "@mosaic/laser-pointer": ["./laser-pointer/src/index.ts"],
      "@mosaic/laser-pointer/*": ["./laser-pointer/src/*"],
      "@mosaic/math": ["./math/src/index.ts"],
      "@mosaic/math/*": ["./math/src/*"],
      "@mosaic/utils": ["./utils/src/index.ts"],
      "@mosaic/utils/*": ["./utils/src/*"],
      "@mosaic/fractional-indexing": ["./fractional-indexing/src/index.ts"],
      "@mosaic/fractional-indexing/*": ["./fractional-indexing/src/*"]
    }
  }
}
