# Session signing secret for NextAuth. Required in production — the dashboard
# falls back to a well-known development secret without it, which is fine
# locally and unsafe to deploy.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Public origin of the dashboard, used by NextAuth to build callback URLs.
# Leave unset to use the incoming request's origin (correct for local dev).
NEXTAUTH_URL=

# Origin of the boards/folders backend. Leave unset to use this app's own route
# handlers, which are backed by the in-memory mock in src/lib/server/db.ts.
# Point this at a real service to swap the mock out — nothing else changes.
NEXT_PUBLIC_API_BASE_URL=
