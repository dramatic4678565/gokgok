{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Mosaic dashboard — boards, folders, favorites and activity",
  "scripts": {
    "predev": "node scripts/ensure-packages.mjs",
    "dev": "next dev -p 3100",
    "prebuild": "node scripts/ensure-packages.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-css-bundle.mjs",
    "check:css": "node scripts/check-css-bundle.mjs",
    "start": "next start -p 3100",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{css,json,md}\" \"*.{json,md}\"",
    "format:check": "prettier --list-different \"src/**/*.{css,json,md}\" \"*.{json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mosaic/mosaic": "0.18.0",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "0.7.1",
    "clsx": "1.1.1",
    "date-fns": "4.4.0",
    "framer-motion": "13.4.6",
    "lucide-react": "1.49.0",
    "next": "14.1.4",
    "next-auth": "4.24.15",
    "next-themes": "0.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.1",
    "zustand": "4.5.6"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "autoprefixer": "10.6.1",
    "eslint-config-next": "14.1.4",
    "jsdom": "22.1.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vitest": "3.0.6"
  }
}
