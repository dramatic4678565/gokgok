MODE="production"

# ---------------------------------------------------------------------------
# Backed services
# ---------------------------------------------------------------------------
#
# Every endpoint below was inherited from upstream and pointed at Excalidraw's
# own infrastructure. Leaving them in place meant this deployment was sending
# real user data to someone else's servers:
#
#   * VITE_APP_BACKEND_V2_*  -- every shareable link resolved, and its content
#                               and metadata, were served by json.excalidraw.com
#   * VITE_APP_WS_SERVER_URL -- live collaboration drawings relayed through
#                               upstream's websocket server
#   * VITE_APP_FIREBASE_CONFIG -- share-link files and persisted scenes stored
#                               in upstream's Firebase project
#   * VITE_APP_AI_BACKEND    -- diagram-to-code prompts sent to upstream's
#                               service
#   * VITE_APP_LIBRARY_*     -- the public library browser and publish
#                               endpoint
#
# They are blank on purpose. A feature that needs one now fails with a clear
# "not configured" message instead of quietly shipping user data to a third
# party. See `isServiceConfigured` in mosaic-app/app_constants.ts and the setup
# table in BRANDING.md.
#
# To point at your own services, set the vars and restart the dev server; the
# values are inlined at build time.

# Shareable link backend (v2 JSON API)
VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=

# Public library browser + publish endpoint
VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=

# Live collaboration websocket server
VITE_APP_WS_SERVER_URL=

# Diagram-to-code AI backend
VITE_APP_AI_BACKEND=

# Firebase: share-link file storage and persisted scenes.
# Must be a single-quoted JSON object. See BRANDING.md for the setup.
VITE_APP_FIREBASE_CONFIG=

# ---------------------------------------------------------------------------
# Premium tier
# ---------------------------------------------------------------------------
#
# The upstream paid product is not resold here; see SHOW_UPSTREAM_PROMOS in
# app_constants.ts. These stay blank so that any promo surface left switched on
# by mistake links to nothing rather than to upstream.

VITE_APP_PLUS_LP=
VITE_APP_PLUS_APP=
VITE_APP_PLUS_AUTO_REDIRECT=false

# ---------------------------------------------------------------------------
# Analytics / error reporting
# ---------------------------------------------------------------------------

VITE_APP_ENABLE_TRACKING=false

# Error reporting is off unless you set a DSN for your own Sentry project.
# See mosaic-app/sentry.ts.
VITE_APP_SENTRY_DSN=
VITE_APP_SENTRY_ENVIRONMENT=
VITE_APP_DISABLE_SENTRY=true

# Public key used to encrypt "export to premium" payloads. Blank because that
# feature is disabled; set it only alongside a premium service you control.
VITE_APP_PLUS_EXPORT_PUBLIC_KEY=

# Set the below flags explicitly to false in production mode since vite loads and merges .env.local vars when  running the build command
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
# Enable eslint in dev server
VITE_APP_ENABLE_ESLINT=false
